# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local

# vercel
.vercel

# JetBrains IDE (WebStorm / IntelliJ)
.idea/

# claude code personal settings
.claude/settings.local.json
# claude code session locks (transient runtime state)
.claude/scheduled_tasks.lock

# mcp server config (contains personal access tokens)
.mcp.json

# typescript
*.tsbuildinfo
next-env.d.ts

# playwright artifacts
/test-results
/playwright-report
/blob-report
/playwright/.cache

# PROJ-29: persisted logged-in storage state (regenerated by globalSetup)
/tests/fixtures/.auth/

# Windows-download artifacts (Mark-of-the-Web "alternate data stream"
# slip through to WSL as plain files). Worthless to track.
*:Zone.Identifier
.gitnexus

# Lokale Fremdprojekte, die im Repo-Wurzelverzeichnis liegen (z. B. `U-Know/`).
# Sie gehoeren nicht zum Produkt, wuerden aber von `git add -A` aufgenommen —
# `U-Know/.gitignore` greift nur relativ zu sich selbst und deckt den Ordner
# auf Repo-Ebene NICHT ab. Wirkt nur fuer git; ESLint und tsc brauchen eigene
# Eintraege (eslint.config.mjs -> ignores, tsconfig.json -> exclude).
U-Know/
.env*
